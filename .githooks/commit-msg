#!/bin/sh
# Enforce Conventional Commits on the subject line.
# https://www.conventionalcommits.org/
#
# Enabled by `bin/setup` (sets core.hooksPath to .githooks/).

commit_msg_file="$1"
subject="$(head -n 1 "$commit_msg_file")"

# Let git-generated messages through (merges, reverts, fixup/squash).
case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|refactor|perf|chore|ci|docs|test|style|build|revert)(\([a-z0-9/_.-]+\))?!?: .+'

if printf '%s' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'MSG'
✖ Commit message does not follow Conventional Commits.

  Expected: <type>[(scope)][!]: <description>
  Types:    feat, fix, refactor, perf, chore, ci, docs, test, style, build, revert

  Examples:
    feat: add Vicenzo/Style/JsonParseSymbolizeNames cop
    fix: stop NestedLetRedefinition flagging sibling lets
    docs: document the <<next>> VersionAdded flow

See CONTRIBUTING.md.
MSG
exit 1
